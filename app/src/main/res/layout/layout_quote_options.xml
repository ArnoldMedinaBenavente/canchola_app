<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="#D1D1D6"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/btnViewMore"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Ver más"
        android:gravity="center_vertical"
        android:drawableStart="@android:drawable/ic_menu_view"
        android:drawablePadding="15dp"
        android:textSize="16sp"
        android:textColor="@color/ios_blue"/>

    <!-- Nuevo botón: ENVIAR A COTIZAR (Solo para locales no sincronizados) -->
    <TextView
        android:id="@+id/btnSendToServer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Enviar a cotizar"
        android:gravity="center_vertical"
        android:drawableStart="@android:drawable/ic_menu_send"
        android:drawablePadding="15dp"
        android:textSize="16sp"
        android:textColor="@color/ios_blue"
        android:visibility="gone"/>

    <!-- Nuevo botón: EDITAR (Solo para locales) -->
    <TextView
        android:id="@+id/btnEditQuote"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Editar "
        android:gravity="center_vertical"
        android:drawableStart="@android:drawable/ic_menu_edit"
        android:drawablePadding="15dp"
        android:textSize="16sp"
        android:textColor="@color/ios_blue"
        android:visibility="gone"/>

    <!-- Nuevo botón: ELIMINAR (Solo para locales) -->
    <TextView
        android:id="@+id/btnDeleteQuote"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Eliminar "
        android:gravity="center_vertical"
        android:drawableStart="@android:drawable/ic_menu_delete"
        android:drawablePadding="15dp"
        android:textSize="16sp"
        android:textColor="@color/ios_blue"
        android:visibility="gone"/>



    <TextView
        android:id="@+id/btnProgress"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Registrar avances"
        android:gravity="center_vertical"
        android:drawableStart="@android:drawable/ic_menu_mylocation"
        android:drawablePadding="15dp"
        android:textSize="16sp"
        android:textColor="@color/ios_blue"/>

    <TextView
        android:id="@+id/btnAddComment"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Agregar comentario"
        android:gravity="center_vertical"
        android:drawableStart="@android:drawable/ic_menu_edit"
        android:drawablePadding="15dp"
        android:textSize="16sp"
        android:textColor="@color/ios_blue"/>

    <TextView
        android:id="@+id/btnAddPhoto"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Agregar foto"
        android:gravity="center_vertical"
        android:drawableStart="@android:drawable/ic_menu_camera"
        android:drawablePadding="15dp"
        android:textSize="16sp"
        android:textColor="@color/ios_blue"/>

</LinearLayout>